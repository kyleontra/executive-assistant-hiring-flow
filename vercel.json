{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/jobs.html",
      "destination": "/candidate-login.html",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/home.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/apply",
      "destination": "/apply.html"
    }
  ]
}
